# Documentation only: DO NOT source/eval this file, and DO NOT put real values in Git.
# Generate separate mode-0600 .env.dev.local / .env.test.local once:
# uv run --locked python scripts/database.py setup --namespace <your-checkout-name>
# Each selected file contains exactly these keys; placeholders below are unusable.
TARGET=<dev-or-test>
NAMESPACE=<explicit-checkout-namespace>
INSTANCE_ID=<stable-generated-uuid4>
PORT=<55432-dev-or-55433-test>
PEER_PORT=<other-target-port>
ADMIN_PASSWORD=<independent-generated-64-hex>
MIGRATOR_PASSWORD=<independent-generated-64-hex>
APP_PASSWORD=<independent-generated-64-hex>
DATABASE_URL=<generated-runtime-url>
MIGRATION_DATABASE_URL=<generated-migrator-url>
